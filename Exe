            editingRecordId
            ? records.find(r=>r.id===editingRecordId)
                ?.caseId||""
            : ""
    };
}

function saveRecord(){

    const record=getFormRecord();

    if(!record.personName){
        alert("नाम आवश्यक है।");
        return;
    }

    /*
      Actual UPDATE
    */

    if(editingRecordId){

        const index=records.findIndex(
            r=>r.id===editingRecordId
        );

        if(index>=0){

            const old=records[index];

            const candidate=
                getPersonDuplicateCandidates(
                    record,
                    old.id
                )[0];

            if(candidate && candidate.score>=70){

                if(
                    !confirm(
                        `यह edited record दूसरे record से ${candidate.score}% match है।\n\nफिर भी update करें?`
                    )
                ){
                    return;
                }
            }

            record.caseId=old.caseId||"";

            if(!record.caseId){

                const c=linkRecordToCase(record);
                record.caseId=c.id;
            }

            records[index]={
                ...old,
                ...record
            };

            persistRecords();
            renderRecords();
            renderCasesQuick();

            editingRecordId=null;

            alert("Record successfully updated.");

            updateSaveButton();

            return;
        }
    }

    const candidate=
        getPersonDuplicateCandidates(record)[0];

    if(candidate && candidate.score>=70){

        if(
            !confirm(
                `यह record ${candidate.score}% duplicate match है।\n\nफिर भी Save करना है?`
            )
        ){
            return;
        }
    }

    const c=linkRecordToCase(record);

    record.caseId=c.id;

    records.push(record);

    attachCurrentArticleToCase(c.id);

    persistRecords();
    persistCases();

    renderRecords();
    renderCasesQuick();

    alert("Record successfully saved.");
}

function attachCurrentArticleToCase(caseId){

    const link=document.getElementById("newsLink").value.trim();

    if(!link) return;

    const item={
        title:
            document.getElementById("newsText").value
                .split("\n")[0]||
                "Accident News Report",

        source:
            document.getElementById("newsSource").value||
            "Unknown Source",

        link:link,

        pubDate:
            document.getElementById("accidentDate").value,

        description:""
    };

    const report=saveNewsReport(item,caseId);

    const c=cases.find(x=>x.id===caseId);

    if(c){

        c.reportIds=c.reportIds||[];

        if(!c.reportIds.includes(report.id)){
            c.reportIds.push(report.id);
        }

        c.sourceNames=c.sourceNames||[];

        if(!c.sourceNames.includes(report.source)){
            c.sourceNames.push(report.source);
        }

        c.updatedAt=new Date().toISOString();

        persistCases();
    }
}

