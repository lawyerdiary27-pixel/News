============================================================ */

function calculateConfidence(p){

    let score=0;

    if(p.name) score+=25;
    if(p.father) score+=15;
    if(p.age) score+=10;
    if(p.address) score+=10;
    if(p.station) score+=10;
    if(p.vehicle) score+=10;
    if(p.cause) score+=5;
    if(p.place) score+=10;
    if(p.status) score+=5;

    return Math.min(score,100);
}

function extractPersonsFromArticle(text){

    const sentences=splitHindiSentences(text);
    const persons=[];

    sentences.forEach((sentence,index)=>{

        const status=sentencePersonStatus(sentence);

        if(!status) return;

        const name=extractNameFromSentence(sentence);

        if(!name) return;

        const father=extractFather(sentence);
        const age=extractAge(sentence);
        const address=extractAddress(sentence);
        const station=extractPoliceStation(sentence);

        const vehicle=
            extractVehicle(sentence) ||
            extractVehicle(sentences[index-1]||"") ||
            extractVehicle(sentences[index+1]||"");

        const cause=
            extractCause(sentence) ||
            extractCause(sentences[index-1]||"") ||
            extractCause(sentences[index+1]||"");

        const place=
            extractPlace(sentence) ||
            extractPlace(sentences[index-1]||"");

        const time=extractTime(sentence);

        persons.push({

            personName:name,
            fatherName:father,
            personAge:age,
            personAddress:address,
            policeStation:station,

            vehicleType:vehicle,
            cause:cause,
            place:place,

            accidentDate:
                document.getElementById("accidentDate").value ||
                localDateInput(),

            accidentTime:time,

            status:status,

            deathCount:status==="Fatal"?1:0,
            injuredCount:status==="Injured"?1:0,

            newsSource:
                document.getElementById("newsSource").value,

            newsLink:
                document.getElementById("newsLink").value,

            evidenceSentence:sentence,

            confidence:calculateConfidence({
                name,
                father,
                age,
                address,
                station,
                vehicle,
                cause,
                place,
                status
            })
        });
    });

    return mergePersons(persons);
}

function mergePersons(list){

    const map=new Map();

    for(const person of list){

        const key=
            normalizeKey(
                person.personName+
                "|"+
                person.fatherName
            );

        if(!key) continue;

        if(!map.has(key)){

            map.set(key,person);

        }else{

            const old=map.get(key);

            [
                "fatherName",
                "personAge",
                "personAddress",
                "policeStation",
                "vehicleType",
                "cause",
                "place",
                "accidentTime",
                "evidenceSentence"
            ].forEach(field=>{

                if(!old[field] && person[field]){
                    old[field]=person[field];
                }
            });

            old.confidence=Math.max(
                old.confidence||0,
                person.confidence||0
            );
        }
    }

    return [...map.values()];
}

