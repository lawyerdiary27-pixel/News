async function scanInternet(){

    const keyword=document.getElementById("searchKeyword")
        .value.trim();

    if(!keyword){
        alert("कृपया search keyword डालें।");
        return;
    }

    setSearchStatus(
        "⏳ Google News पर हिंदी में ताज़ा खबरें खोजी जा रही हैं..."
    );

    const query=
        `${keyword} सड़क हादसा दुर्घटना एक्सीडेंट${googleDateQuery()}`;

    try{

        const result=await fetchRSS(
            googleNewsURL(query)
        );

        let items=parseRSSResult(result)
            .filter(isInsideDateRange);

        items=deduplicateNews(items);
        items=sortLatest(items);

        if(
            items.length===0 &&
            document.getElementById("dateRange").value!=="all"
        ){

            setSearchStatus(
                "आज की exact range में result नहीं मिला — पिछले 7 दिनों की खबरें खोजी जा रही हैं..."
            );

            const fallback=
                `${keyword} सड़क हादसा दुर्घटना after:${todayMinusDays(7)} before:${tomorrowDate()}`;

            const result2=await fetchRSS(
                googleNewsURL(fallback)
            );

            items=deduplicateNews(
                parseRSSResult(result2)
            );

            items=sortLatest(items);
        }

        currentNewsResults=items;

        renderNewsResults(items);

        setSearchStatus(
            `✅ ${items.length} खबरें मिलीं • ${result.method} • नवीनतम पहले`
        );

    }catch(error){

        console.error(error);

        setSearchStatus(
            "❌ Google News search failed: "+error.message
        );

        renderNewsResults([]);
    }
}


