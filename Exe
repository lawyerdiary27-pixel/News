async function fetchWithTimeout(url,options={},timeout=15000){

    const controller=new AbortController();

    const timer=setTimeout(
        ()=>controller.abort(),
        timeout
    );

    try{

        const response=await fetch(url,{
            ...options,
            signal:controller.signal
        });

        if(!response.ok){
            throw new Error("HTTP "+response.status);
        }

        return await response.text();

    }finally{
        clearTimeout(timer);
    }
}

async function fetchRSS(url){

    const attempts=[
        {
            name:"Direct",
            url:url
        },
        {
            name:"AllOrigins",
            url:"https://api.allorigins.win/get?url="+
                encodeURIComponent(url)
        },
        {
            name:"CorsProxy",
            url:"https://corsproxy.io/?"+
                encodeURIComponent(url)
        },
        {
            name:"CodeTabs",
            url:"https://api.codetabs.com/v1/proxy?quest="+
                encodeURIComponent(url)
        },
        {
            name:"RSS2JSON",
            url:"https://api.rss2json.com/v1/api.json?rss_url="+
                encodeURIComponent(url)
        }
    ];

    let lastError=null;

    for(const attempt of attempts){

        try{

            const text=await fetchWithTimeout(
                attempt.url,{},15000
            );

            let finalText=text;

            try{

                const parsed=JSON.parse(text);

                if(parsed && parsed.contents){
                    finalText=parsed.contents;
                }

                if(parsed && Array.isArray(parsed.items)){
                    return {
                        method:attempt.name,
                        rss2json:parsed
                    };
                }

            }catch(e){}

            if(
                finalText &&
                (
                    finalText.includes("<rss") ||
                    finalText.includes("<feed") ||
                    finalText.includes("<item")
                )
            ){
                return {
                    method:attempt.name,
                    text:finalText
                };
            }

        }catch(err){
            lastError=err;
        }
    }

    throw lastError||new Error("RSS fetch failed");
}


/* ============================================================
   GOOGLE NEWS
============================================================ */

function googleNewsURL(query){
    return "https://news.google.com/rss/search?"+
        "q="+encodeURIComponent(query)+
        "&hl=hi&gl=IN&ceid=IN:hi";
}

function parseRSSResult(result){

    if(result.rss2json){

        return result.rss2json.items.map(item=>({
            title:cleanText(item.title),
            link:item.link||"",
            description:cleanText(item.description),
            pubDate:item.pubDate||"",
            source:item.author||"Google News"
        }));

    }

    const parser=new DOMParser();

    const xml=parser.parseFromString(
        result.text,
        "text/xml"
    );

    return [...xml.querySelectorAll("item")].map(item=>{

        const sourceNode=item.querySelector("source");

        return {
            title:cleanText(
                item.querySelector("title")?.textContent||""
            ),
            link:cleanText(
                item.querySelector("link")?.textContent||""
            ),
            description:cleanText(
                item.querySelector("description")?.textContent||""
            ),
            pubDate:
                item.querySelector("pubDate")?.textContent||"",
            source:
                cleanText(
                    sourceNode?.textContent||"Google News"
                )
        };
    });
}

function sourceName(source,link=""){

    const s=(source+" "+link).toLowerCase();

    if(s.includes("amarujala")||s.includes("amar ujala"))
        return "Amar Ujala";

    if(s.includes("jagran"))
        return "Dainik Jagran";

    if(s.includes("bhaskar"))
        return "Dainik Bhaskar";

    if(s.includes("google"))
        return "Google News";

    return source||"Google News";
}

function deduplicateNews(items){

    const map=new Map();

    for(const item of items){

        const key=
            normalizeKey(item.link) ||
            normalizeKey(item.title);

        if(!key) continue;

        const old=map.get(key);

        if(!old){
            map.set(key,item);
        }else{

            const oldDate=new Date(old.pubDate).getTime()||0;
            const newDate=new Date(item.pubDate).getTime()||0;

            if(newDate>oldDate){
                map.set(key,item);
            }
        }
    }

    return [...map.values()];
}

function sortLatest(items){

    return items.sort((a,b)=>{
        const da=new Date(a.pubDate).getTime()||0;
        const db=new Date(b.pubDate).getTime()||0;
        return db-da;
    });
}


