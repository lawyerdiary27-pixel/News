<script>

/* ============================================================
   CYBERNEXUS V4.5
   BASE-COMPATIBLE DATA LAYER
============================================================ */

const RECORD_KEY = "myAccidentRecords";
const CASE_KEY = "myAccidentCases";
const NEWS_KEY = "myAccidentNewsReports";
const MERGE_KEY = "myAccidentMergeHistory";
const PRINT_KEY = "myAccidentPrintFields";

let records = loadJSON(RECORD_KEY,[]);
let cases = loadJSON(CASE_KEY,[]);
let newsReports = loadJSON(NEWS_KEY,[]);
let mergeHistory = loadJSON(MERGE_KEY,[]);

let currentNewsResults = [];
let extractedPersons = [];
let vehicleChart = null;

let currentCaseId = null;
let currentDuplicatePlan = [];
let editingRecordId = null;


/* ============================================================
   GENERIC STORAGE
============================================================ */

function loadJSON(key,fallback){
    try{
        const x = JSON.parse(localStorage.getItem(key) || "null");
        return Array.isArray(x) || typeof x === "object" && x !== null
            ? x
            : fallback;
    }catch(e){
        return fallback;
    }
}

function persist(key,value){
    localStorage.setItem(key,JSON.stringify(value));
}

function persistRecords(){
    persist(RECORD_KEY,records);
}

function persistCases(){
    persist(CASE_KEY,cases);
}

function persistNews(){
    persist(NEWS_KEY,newsReports);
}

function persistMergeHistory(){
    persist(MERGE_KEY,mergeHistory);
}


/* ============================================================
   BASIC HELPERS
============================================================ */

function pad(n){
    return String(n).padStart(2,"0");
}

function localDateInput(d=new Date()){
    return d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate());
}

function formatDate(d){
    if(!d || isNaN(new Date(d))) return "—";
    return new Date(d).toLocaleDateString("hi-IN",{
        day:"2-digit",
        month:"short",
        year:"numeric"
    });
}

function normalizeHindiDigits(text){
    const map={
        "०":"0","१":"1","२":"2","३":"3","४":"4",
        "५":"5","६":"6","७":"7","८":"8","९":"9"
    };
    return String(text||"").replace(/[०-९]/g,m=>map[m]);
}

function normalizeKey(text){
    return String(text||"")
        .toLowerCase()
        .normalize("NFKC")
        .replace(/[^\p{L}\p{N}]+/gu," ")
        .replace(/\s+/g," ")
        .trim();
}

function cleanText(text){
    const div=document.createElement("div");
    div.innerHTML=text||"";
    return (div.textContent||div.innerText||"")
        .replace(/\s+/g," ")
        .trim();
}

function escapeHTML(value){
    return String(value??"")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");
}

function escapeAttribute(value){
    return escapeHTML(value).replace(/`/g,"&#096;");
}

function makeId(prefix="id"){
