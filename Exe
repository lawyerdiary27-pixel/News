/* ============================================================
   DUPLICATE CHECK
============================================================ */

function checkDuplicates(){

    let duplicateCount=0;

    extractedPersons=extractedPersons.map(person=>{

        const candidates=
            getPersonDuplicateCandidates(person);

        person.duplicateCandidates=candidates;
        person.duplicateScore=
            candidates[0]?.score||0;

        person.isDuplicate=
            person.duplicateScore>=70;

        if(person.isDuplicate){
            duplicateCount++;
        }

        return person;
    });

    document.getElementById("duplicateBadge").textContent=
        duplicateCount+" Duplicate";

    renderMultiPersonPreview();

    return duplicateCount;
}


