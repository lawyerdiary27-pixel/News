/* ============================================================
   STRONG PERSON DUPLICATE ENGINE
============================================================ */

function tokenSimilarity(a,b){

    const A=new Set(normalizeKey(a).split(" ").filter(Boolean));
    const B=new Set(normalizeKey(b).split(" ").filter(Boolean));

    if(!A.size||!B.size) return 0;

    let common=0;

    A.forEach(x=>{
        if(B.has(x)) common++;
    });

    return common/Math.max(A.size,B.size);
}

function dateNear(a,b){

    if(!a||!b) return false;

    const da=new Date(a);
    const db=new Date(b);

    if(isNaN(da)||isNaN(db)) return false;

    return Math.abs(da-db)<=86400000;
}

function personDuplicateScore(person,record){

    if(record.mergedInto) return 0;

    let score=0;

    const nameSim=tokenSimilarity(
        person.personName,
        record.personName
    );

    if(nameSim===1) score+=55;
    else if(nameSim>=.7) score+=40;
    else if(nameSim>=.5) score+=25;

    const fatherSim=tokenSimilarity(
        person.fatherName,
        record.fatherName
    );

    if(fatherSim===1 && fatherSim>0) score+=18;
    else if(fatherSim>=.5) score+=10;

    const placeSim=tokenSimilarity(
        person.place,
        record.place
    );

    if(placeSim===1 && placeSim>0) score+=12;
    else if(placeSim>=.5) score+=7;

    if(
        person.accidentDate &&
        record.accidentDate &&
        person.accidentDate===record.accidentDate
    ){
        score+=10;
    }else if(
        dateNear(person.accidentDate,record.accidentDate)
    ){
        score+=5;
    }

    if(
        normalizeKey(person.policeStation) &&
        normalizeKey(person.policeStation)===
        normalizeKey(record.policeStation)
    ){
        score+=3;
    }

    if(
        normalizeKey(person.vehicleType) &&
        normalizeKey(person.vehicleType)===
        normalizeKey(record.vehicleType)
    ){
        score+=2;
    }

    return Math.min(score,100);
}

function getPersonDuplicateCandidates(person,excludeId=null){

    return records
        .filter(r=>!excludeId||r.id!==excludeId)
        .map(record=>({
            record,
            score:personDuplicateScore(person,record)
        }))
        .filter(x=>x.score>=45)
        .sort((a,b)=>b.score-a.score);
}


/* ============================================================
   CASE INTELLIGENCE ENGINE
============================================================ */

function buildCaseFingerprint(record){

    return [
        record.accidentDate,
        normalizeKey(record.place),
        normalizeKey(record.policeStation),
        normalizeKey(record.vehicleType),
        normalizeKey(record.cause)
    ].join("|");
}

function caseSimilarity(a,b){

    let score=0;

    if(
        a.accidentDate &&
        b.accidentDate &&
        a.accidentDate===b.accidentDate
    ){
        score+=30;
    }else if(dateNear(a.accidentDate,b.accidentDate)){
        score+=18;
    }

    const place=tokenSimilarity(a.place,b.place);

    if(place===1 && place>0) score+=25;
    else if(place>=.6) score+=18;
    else if(place>=.35) score+=10;

    const station=tokenSimilarity(
        a.policeStation,b.policeStation
    );

    if(station===1&&station>0) score+=8;
    else if(station>=.5) score+=5;

    const vehicle=tokenSimilarity(
        a.vehicleType,b.vehicleType
    );

    if(vehicle===1&&vehicle>0) score+=8;
    else if(vehicle>=.5) score+=4;

    const cause=tokenSimilarity(
        a.cause,b.cause
    );

    if(cause===1&&cause>0) score+=5;

    const time=tokenSimilarity(
        a.accidentTime,b.accidentTime
    );

    if(time===1&&time>0) score+=4;

    const personName=tokenSimilarity(
        a.personName,b.personName
    );

    if(personName===1&&personName>0) score+=20;
    else if(personName>=.5) score+=10;

    return Math.min(score,100);
}

function findMatchingCase(record){

    return cases
        .map(c=>{

            const representatives=
                records.filter(r=>
                    r.caseId===c.id &&
                    !r.mergedInto
                );

            let best=0;

            representatives.forEach(r=>{
                best=Math.max(
                    best,
                    caseSimilarity(record,r)
                );
            });

            if(!representatives.length){

                best=caseSimilarity(
                    record,
                    c.representative||{}
                );
            }

            return {
                case:c,
                score:best
            };
        })
        .filter(x=>x.score>=60)
        .sort((a,b)=>b.score-a.score)[0]||null;
}

function createCaseFromRecord(record){

    const c={
        id:makeId("case"),
        caseKey:buildCaseFingerprint(record),
        title:
            record.place
            ? "Accident — "+record.place
            : "Accident Case",
        accidentDate:record.accidentDate||"",
        place:record.place||"",
        policeStation:record.policeStation||"",
        representative:{...record},
        createdAt:new Date().toISOString(),
        updatedAt:new Date().toISOString(),
        reportIds:[],
        sourceNames:[]
    };

    cases.push(c);
    persistCases();

    return c;
}

function getOrCreateCase(record){

    const match=findMatchingCase(record);

    if(match && match.score>=60){

        match.case.updatedAt=
            new Date().toISOString();

        return match.case;
    }

    return createCaseFromRecord(record);
}

function linkRecordToCase(record){

    const c=getOrCreateCase(record);

    record.caseId=c.id;

    if(!c.accidentDate && record.accidentDate)
        c.accidentDate=record.accidentDate;

    if(!c.place && record.place)
        c.place=record.place;

    if(!c.policeStation && record.policeStation)
        c.policeStation=record.policeStation;

    c.updatedAt=new Date().toISOString();

    persistCases();

    return c;
}


/* ============================================================
   NEWS REPORT LAYER
============================================================ */

function newsReportKey(item){

    return normalizeKey(item.link) ||
        normalizeKey(item.title);
}

function saveNewsReport(item,caseId){

    if(!item) return null;

    const key=newsReportKey(item);

    const existing=newsReports.find(r=>
        newsReportKey(r)===key
    );

    if(existing){

        if(caseId && !existing.caseId){
            existing.caseId=caseId;
        }

        persistNews();

        return existing;
    }

    const report={
        id:makeId("news"),
        caseId:caseId||"",
        title:item.title||"",
        source:sourceName(item.source,item.link),
        link:item.link||"",
        published:item.pubDate||"",
        description:item.description||"",
        createdAt:new Date().toISOString()
    };

    newsReports.push(report);

    persistNews();

    return report;
}

function saveNewsReportFromResult(index){

    const item=currentNewsResults[index];

    if(!item) return;

    const temp={
        personName:"",
        accidentDate:
            item.pubDate
            ? localDateInput(new Date(item.pubDate))
            : localDateInput(),
        place:"",
        policeStation:"",
        vehicleType:"",
        cause:"",
        accidentTime:"",
        status:"Under Investigation"
    };

    const c=getOrCreateCase(temp);

    const report=saveNewsReport(item,c.id);

    c.reportIds=c.reportIds||[];

    if(!c.reportIds.includes(report.id)){
        c.reportIds.push(report.id);
    }

    c.sourceNames=c.sourceNames||[];

    if(!c.sourceNames.includes(report.source)){
        c.sourceNames.push(report.source);
    }

    c.updatedAt=new Date().toISOString();

    persistCases();

    alert("News report Case Intelligence में link हो गई।");

    renderCasesQuick();
}


