============================================================ */

function todayMinusDays(days){
    const d=new Date();
    d.setDate(d.getDate()-days);
    return localDateInput(d);
}

function tomorrowDate(){
    const d=new Date();
    d.setDate(d.getDate()+1);
    return localDateInput(d);
}

function googleDateQuery(){

    const mode=document.getElementById("dateRange").value;

    if(mode==="all") return "";

    let days=1;

    if(mode==="today") days=1;
    if(mode==="24h") days=1;
    if(mode==="3d") days=3;
    if(mode==="7d") days=7;

    return ` after:${todayMinusDays(days)} before:${tomorrowDate()}`;
}

function isToday(date){
    if(!date) return false;

    const d=new Date(date);
    const now=new Date();

    return d.getFullYear()===now.getFullYear() &&
           d.getMonth()===now.getMonth() &&
           d.getDate()===now.getDate();
}

function isInsideDateRange(pubDate){

    const mode=document.getElementById("dateRange").value;

    if(mode==="all" || !pubDate) return true;

    const published=new Date(pubDate);

    if(isNaN(published)) return true;

    const now=new Date();

    let hours=24;

    if(mode==="today") hours=36;
    if(mode==="24h") hours=24;
    if(mode==="3d") hours=72;
    if(mode==="7d") hours=168;

    return now.getTime()-published.getTime()
        <= hours*60*60*1000;
}


