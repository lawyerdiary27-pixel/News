/* ============================================================
   TIMELINE
============================================================ */

function renderTimeline(caseId){

    const events=[];

    newsReports
        .filter(r=>r.caseId===caseId)
        .forEach(r=>{
            events.push({
                date:r.published||r.createdAt,
                type:"News Report",
                title:r.title,
                detail:r.source
            });
        });

    records
        .filter(r=>r.caseId===caseId)
        .forEach(r=>{
            events.push({
                date:r.createdAt,
                type:"Person Record",
                title:r.personName,
                detail:r.status==="Fatal"
                    ?"मृतक record"
                    :"घायल record"
            });
        });

    mergeHistory
        .filter(h=>h.caseId===caseId)
        .forEach(h=>{
            events.push({
                date:h.timestamp,
                type:"Duplicate Merge",
                title:
                    `${h.sourceName} → ${h.targetName}`,
                detail:`${h.score}% match`
            });
        });

    events.sort((a,b)=>
        new Date(a.date)-new Date(b.date)
    );

    if(!events.length){

        return `
        <div class="muted">
            Timeline के लिए अभी data उपलब्ध नहीं है।
        </div>
        `;
    }

    return events.map(e=>`

    <div class="timeline-item">

    <div class="text-xs muted">
    ${escapeHTML(
        e.date
        ? formatDate(e.date)
        : "—"
    )}
    </div>

    <div class="font-bold mt-1">
    ${escapeHTML(e.type)}
    </div>

    <div class="text-sm">
    ${escapeHTML(e.title||"")}
    </div>

    <div class="text-xs muted">
    ${escapeHTML(e.detail||"")}
    </div>

    </div>

    `).join("");
}


