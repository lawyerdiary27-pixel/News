function buildSourceCoverage(reports){

    const map={};

    reports.forEach(r=>{

        const source=r.source||"Unknown";

        if(!map[source]){
            map[source]={
                count:0,
                links:[]
            };
        }

        map[source].count++;

        if(r.link && !map[source].links.includes(r.link)){
            map[source].links.push(r.link);
        }
    });

    return map;
}

