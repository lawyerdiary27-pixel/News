                record.vehicleType||"अन्य";

            counts[vehicle]=
                (counts[vehicle]||0)+1;
        });

    const canvas=document.getElementById(
        "vehicleChart"
    );

    if(!canvas) return;

    if(vehicleChart){
        vehicleChart.destroy();
    }

    vehicleChart=new Chart(
        canvas,
        {
            type:"doughnut",

            data:{
                labels:Object.keys(counts),

                datasets:[{
                    data:Object.values(counts)
                }]
            },

            options:{
                responsive:true,
                plugins:{
                    legend:{
                        position:"bottom"
                    }
                }
            }
        }
    );
}


/* ============================================================
   MIGRATION / BACKWARD COMPATIBILITY
============================================================ */

function migrateOldRecords(){

    let changed=false;

    records=records.map(r=>{

        if(!r.id){
            r.id=makeId("person");
            changed=true;
        }

        if(!r.createdAt){
            r.createdAt=new Date().toISOString();
            changed=true;
        }

        if(!r.updatedAt){
            r.updatedAt=r.createdAt;
            changed=true;
        }

        if(r.mergedInto===undefined){
            r.mergedInto="";
            changed=true;
        }

        if(r.isMerged===undefined){
            r.isMerged=false;
            changed=true;
        }

        if(!r.caseId){

            const c=getOrCreateCase(r);

            r.caseId=c.id;

            changed=true;
        }

        return r;
    });

    if(changed){
        persistRecords();
        persistCases();
    }
}


/* ============================================================
   REBUILD CASE REPORT LINKS
============================================================ */

function rebuildCaseReportLinks(){

    let changed=false;

    cases.forEach(c=>{

        c.reportIds=c.reportIds||[];
        c.sourceNames=c.sourceNames||[];

        newsReports
            .filter(r=>r.caseId===c.id)
            .forEach(r=>{

                if(!c.reportIds.includes(r.id)){
                    c.reportIds.push(r.id);
                    changed=true;
                }

                if(
                    r.source &&
                    !c.sourceNames.includes(r.source)
                ){
                    c.sourceNames.push(r.source);
                    changed=true;
                }
            });
    });

    if(changed){
        persistCases();
    }
}


