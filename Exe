        }
    ];

    let lastError=null;

    for(const attempt of attempts){

        try{

            const text=await fetchWithTimeout(
                attempt.url,{},18000
            );

            let articleText=text;

            try{

                const json=JSON.parse(text);

                if(json.contents){
                    articleText=json.contents;
                }

            }catch(e){}

            articleText=cleanArticleText(articleText);

            if(articleText && articleText.length>300){

                return {
                    text:articleText,
                    method:attempt.name
                };
            }

        }catch(err){
            lastError=err;
        }
    }

    throw lastError||new Error("Article extraction failed");
}

function cleanArticleText(text){

    let t=String(text||"");

    t=t.replace(/<script[\s\S]*?<\/script>/gi," ");
    t=t.replace(/<style[\s\S]*?<\/style>/gi," ");

    return cleanText(t)
        .replace(/\s{2,}/g," ")
        .trim();
}

