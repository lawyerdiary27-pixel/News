function recordFromPerson(p){

    return {

        id:makeId("person"),

        personName:p.personName||"",
        fatherName:p.fatherName||"",
        personAge:p.personAge||"",
        personAddress:p.personAddress||"",
        policeStation:p.policeStation||"",

        vehicleType:p.vehicleType||"",
        cause:p.cause||"",
        place:p.place||"",

        accidentDate:p.accidentDate||"",
        accidentTime:p.accidentTime||"",

        status:p.status||"",

        deathCount:p.deathCount||0,
        injuredCount:p.injuredCount||0,

        newsSource:
            p.newsSource||
            document.getElementById("newsSource").value,

        newsLink:
            p.newsLink||
            document.getElementById("newsLink").value,

        evidenceSentence:p.evidenceSentence||"",
        extractionConfidence:p.confidence||0,

        createdAt:new Date().toISOString(),
        updatedAt:new Date().toISOString(),

        mergedInto:"",
        isMerged:false
    };
}

function applySavePlan(){

    const now=new Date().toISOString();

    let saved=0;
    let merged=0;
    let skipped=0;

    currentDuplicatePlan.forEach(plan=>{

        const p=plan.person;

        if(plan.action==="skip"){
            skipped++;
            return;
        }

        if(plan.action==="merge" && plan.candidate){

            mergeRecords(
                recordFromPerson(p),
                plan.candidate
            );

            merged++;
            return;
        }

        const record=recordFromPerson(p);

        const c=linkRecordToCase(record);

        record.caseId=c.id;

        records.push(record);

        saved++;

        /*
          Current article is also attached
          to the same Case.
        */

        const source=
            document.getElementById("newsSource").value;

        const link=
            document.getElementById("newsLink").value;

        if(link){

            const report=saveNewsReport({
                title:
                    document.getElementById("newsText").value
                    .split("\n")[0]||
                    "Accident News Report",

                source:source||"Unknown Source",
                link:link,
                pubDate:record.accidentDate,
                description:""
            },c.id);

            c.reportIds=c.reportIds||[];

            if(!c.reportIds.includes(report.id)){
                c.reportIds.push(report.id);
            }

            c.sourceNames=c.sourceNames||[];

            if(!c.sourceNames.includes(report.source)){
                c.sourceNames.push(report.source);
            }
        }
    });

    persistRecords();
    persistCases();
    persistNews();
    persistMergeHistory();

    closeDuplicateModal();

    renderRecords();
    renderCasesQuick();

    alert(
        `Save Plan पूरा हुआ।\n\n`+
        `New: ${saved}\n`+
        `Merged: ${merged}\n`+
        `Skipped: ${skipped}`
    );

    extractedPersons=[];
    renderMultiPersonPreview();
}

function mergeRecords(source,target){

    const fields=[
        "fatherName",
        "personAge",
        "personAddress",
        "policeStation",
        "vehicleType",
        "cause",
        "place",
        "accidentDate",
        "accidentTime",
        "newsSource",
        "newsLink",
        "evidenceSentence"
    ];

    const filled=[];

    fields.forEach(field=>{

        if(!target[field] && source[field]){

            target[field]=source[field];
            filled.push(field);
        }
    });

    target.updatedAt=new Date().toISOString();

    /*
      Preserve history instead of deleting duplicate.
    */

    const sourceId=source.id;

    const history={
        id:makeId("merge"),
        caseId:target.caseId||"",
        sourceRecordId:sourceId,
        targetRecordId:target.id,
        sourceName:source.personName,
        targetName:target.personName,
        score:personDuplicateScore(source,target),
        action:"merged",
        fieldsMerged:filled,
        timestamp:new Date().toISOString()
    };

    mergeHistory.push(history);

    /*
      Keep a lightweight merged record in history.
      It is not shown as active person.
    */

    source.mergedInto=target.id;
    source.isMerged=true;
    source.mergedAt=new Date().toISOString();

    if(target.caseId){
        source.caseId=target.caseId;
    }

    records.push(source);

    persistRecords();
    persistMergeHistory();
}


