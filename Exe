   SENTENCE / ENTITY EXTRACTION
============================================================ */

function splitHindiSentences(text){

    return String(text||"")
        .replace(/\r/g," ")
        .split(/(?<=[।!?])\s+|(?<=[.!?])\s+|\n+/)
        .map(s=>s.trim())
        .filter(s=>s.length>15);
}

function extractNameFromSentence(sentence){

    const s=normalizeHindiDigits(sentence);

    const patterns=[

        /(?:मृतक|मृत|घायल|जख्मी|युवक|युवती|व्यक्ति|चालक|सवार)\s+([A-Zअ-ह][A-Za-zअ-ह़-य़्‌'’-]{1,}(?:\s+[A-Zअ-ह][A-Za-zअ-ह़-य़्‌'’-]{1,}){0,3})/i,

        /(?:नाम|पहचान)\s*(?:के रूप में)?\s*([A-Zअ-ह][A-Za-zअ-ह़-य़्‌'’-]+(?:\s+[A-Zअ-ह][A-Za-zअ-ह़-य़्‌'’-]+){0,3})/i,

        /([A-Z][A-Za-z]+(?:\s+[A-Z][A-Za-z]+){1,3})\s+(?:की मौत|की मृत्यु|घायल|जख्मी)/i,

        /([A-Zअ-ह][A-Za-zअ-ह़-य़्‌'’-]+(?:\s+[A-Zअ-ह][A-Za-zअ-ह़-य़्‌'’-]+){0,3})\s+(?:पुत्र|पुत्री|निवासी)/i,

        /([A-Z][A-Za-z]+(?:\s+[A-Z][A-Za-z]+){1,3})\s+(?:s\/o|d\/o|son of|daughter of)/i
    ];

    for(const regex of patterns){

        const m=s.match(regex);

        if(m && m[1]){

            const name=m[1]
                .replace(/[,:;।]+$/,"")
                .trim();

            if(
                name.length>2 &&
                !/^(हादसे|सड़क|मौके|घटना|पुलिस|जिले|इसके|एक|दो|तीन)$/i
                    .test(name)
            ){
                return name;
            }
        }
    }

    return "";
}

function extractFather(sentence){

    const s=normalizeHindiDigits(sentence);

    const patterns=[

        /(?:पिता का नाम|पिता)\s*[:\-]?\s*([A-Zअ-ह][A-Za-zअ-ह़-य़्‌'’-]+(?:\s+[A-Zअ-ह][A-Za-zअ-ह़-य़्‌'’-]+){0,3})/i,

        /(?:s\/o|son of)\s+([A-Z][A-Za-z]+(?:\s+[A-Z][A-Za-z]+){0,3})/i,

        /(?:d\/o|daughter of)\s+([A-Z][A-Za-z]+(?:\s+[A-Z][A-Za-z]+){0,3})/i,

        /([A-Zअ-ह][A-Za-zअ-ह़-य़्‌'’-]+(?:\s+[A-Zअ-ह][A-Za-zअ-ह़-य़्‌'’-]+){0,3})\s*(?:के|की)?\s*पुत्र\s+([A-Zअ-ह][A-Za-zअ-ह़-य़्‌'’-]+(?:\s+[A-Zअ-ह][A-Za-zअ-ह़-य़्‌'’-]+){0,3})/i,

        /([A-Zअ-ह][A-Za-zअ-ह़-य़्‌'’-]+(?:\s+[A-Zअ-ह][A-Za-zअ-ह़-य़्‌'’-]+){0,3})\s*(?:के|की)?\s*पुत्री\s+([A-Zअ-ह][A-Za-zअ-ह़-य़्‌'’-]+(?:\s+[A-Zअ-ह][A-Za-zअ-ह़-य़्‌'’-]+){0,3})/i
    ];

    for(const regex of patterns){

        const m=s.match(regex);

        if(m){

            const candidate=
                m.length>2 && m[2]
                ? m[2]
                : m[1];

            if(candidate){
                return candidate
                    .replace(/[,:;।]+$/,"")
                    .trim();
            }
        }
    }

    return "";
}

function extractAge(sentence){

    const s=normalizeHindiDigits(sentence);

    const m=
        s.match(
            /(?:उम्र|आयु|aged|age)\s*(?:करीब|लगभग)?\s*(\d{1,3})\s*(?:वर्ष|साल|year|years)?/i
        ) ||
        s.match(
            /(\d{1,3})\s*(?:वर्षीय|साल का|साल की)/i
        );

    return m?m[1]:"";
}

function extractAddress(sentence){

    const s=normalizeHindiDigits(sentence);

    const patterns=[

        /(?:निवासी|रहने वाले|रहने वाला|रहती थी|निवास)\s*(?:[:\-])?\s*([^।,;]+)/i,

        /(?:ग्राम|गांव|मोहल्ला|कस्बा)\s*[:\-]?\s*([^।,;]+)/i
    ];

    for(const regex of patterns){

        const m=s.match(regex);

        if(m && m[1]){
            return m[1].trim();
        }
    }

    return "";
}

function extractPoliceStation(sentence){

    const m=normalizeHindiDigits(sentence).match(
        /(?:थाना|कोतवाली)\s*[:\-]?\s*([A-Zअ-ह][^।,;]+)/i
    );

    return m?m[1].trim():"";
}

function extractPlace(text){

    const patterns=[

        /(?:स्थान|जगह|मौके|घटना स्थल)\s*[:\-]?\s*([^।\n]+)/i,

        /(?:के पास|नजदीक|निकट)\s+([A-Zअ-ह][A-Za-zअ-ह़-य़्‌'’\-\s]{2,50})/i,

        /(?:at|near|in)\s+([A-Z][A-Za-z\s\-]{2,50})/i
    ];

    for(const regex of patterns){

        const m=String(text||"").match(regex);

        if(m && m[1]){
            return m[1]
                .split(/(?:।|,|;)/)[0]
                .trim();
        }
    }

    return "";
}

function extractVehicle(text){

    const patterns=[

        ["बाइक","बाइक|मोटरसाइकिल|motorcycle|bike"],
        ["स्कूटी","स्कूटी|scooty|scooter"],
        ["कार","कार|car|sedan|hatchback"],
        ["ट्रक","ट्रक|truck"],
        ["बस","बस|bus"],
        ["ट्रैक्टर","ट्रैक्टर|tractor"],
        ["टेंपो","टेंपो|tempo"],
        ["ऑटो","ऑटो|auto|e-rickshaw|ई-रिक्शा"],
        ["पिकअप","पिकअप|pickup"],
        ["टैंकर","टैंकर|tanker"],
        ["डंपर","डंपर|dumper"],
        ["डीसीएम","डीसीएम|DCM"],
        ["बोलेरो","बोलेरो|Bolero"],
        ["मैजिक","मैजिक|Magic"]
    ];

    for(const [name,pattern] of patterns){

        if(new RegExp(pattern,"i").test(text||"")){
            return name;
        }
    }

    return "";
}

function extractCause(text){

    const rules=[

        ["तेज रफ्तार",/तेज रफ्तार|तेज गति|रफ्तार तेज|overspeed|speeding/i],

        ["टक्कर / भिड़ंत",/टक्कर|भिड़ंत|टकरा|collision|crash|hit/i],

        ["गलत दिशा",/गलत दिशा|wrong side|wrong way/i],

        ["शराब / नशा",/शराब|नशे|नशे में|drunk|alcohol/i],

        ["लापरवाही",/लापरवाही|negligence|negligent/i],

        ["ब्रेक फेल",/ब्रेक फेल|ब्रेक खराब|brake failure/i],

        ["गड्ढा",/गड्ढा|गड्ढे|pothole/i],

        ["पलटना",/पलट|पलटने|overturn|overturned/i],

        ["हिट एंड रन",/हिट एंड रन|hit and run/i],

        ["पशु आने से",/पशु|जानवर|animal|cattle/i]
    ];

    for(const [name,regex] of rules){

        if(regex.test(text||"")){
            return name;
        }
    }

    return "";
}

function extractStatus(text){

    const s=normalizeHindiDigits(text);

    if(
        /मौत|मृत|मृतक|दम तोड़|शव|killed|dead|death|died/i.test(s)
    ){
        return "Fatal";
    }

    if(
        /घायल|जख्मी|अस्पताल|injured|hospital/i.test(s)
    ){
        return "Injured";
    }

    return "Under Investigation";
}

function extractCount(text,type){

    const s=normalizeHindiDigits(text);

    const patterns=
        type==="death"
        ?
        [
            /(\d+)\s*(?:लोगों|लोग|व्यक्तियों|व्यक्ति|की)?\s*(?:की)?\s*(?:मौत|मृत्यु|मृतक|killed|dead)/i,
            /(?:मौत|मृत्यु|मृतक|killed|dead)\s*(?:हुई|हुए|की)?\s*(\d+)/i
        ]
        :
        [
            /(\d+)\s*(?:लोगों|लोग|व्यक्तियों|व्यक्ति)?\s*(?:के)?\s*घायल/i,
            /घायल\s*(?:हुए|हुई)?\s*(\d+)/i
        ];

    for(const regex of patterns){

        const m=s.match(regex);

        if(m){
            return parseInt(m[1],10);
        }
    }

    return 0;
}

function extractTime(text){

    const s=normalizeHindiDigits(text);

    const m=s.match(
        /(\d{1,2}:\d{2})\s*(बजे)?\s*(सुबह|दोपहर|शाम|रात)?/i
    );

    if(m) return m[0].trim();

    for(const word of ["सुबह","दोपहर","शाम","रात"]){
        if(s.includes(word)) return word;
    }

    return "";
}

function sentencePersonStatus(sentence){

    if(
        /मौत|मृत|मृतक|दम तोड़|शव|killed|dead|died/i
            .test(sentence)
    ){
        return "Fatal";
    }

    if(
        /घायल|जख्मी|अस्पताल|injured/i.test(sentence)
    ){
        return "Injured";
    }

    return "";
}


